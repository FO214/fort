{
  "name": "mobile",
  "version": "1.0.0",
  "main": "index.ts",
  "dependencies": {
    "@expo-google-fonts/barlow-condensed": "^0.4.1",
    "@expo-google-fonts/ibm-plex-mono": "^0.4.2",
    "@expo-google-fonts/ibm-plex-sans": "^0.4.1",
    "@expo/metro-runtime": "~58.0.17",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "expo": "^58.0.0",
    "expo-asset": "~58.0.21",
    "expo-audio": "~58.0.12",
    "expo-blur": "~58.0.6",
    "expo-camera": "~58.0.14",
    "expo-clipboard": "~58.0.4",
    "expo-constants": "~58.0.16",
    "expo-font": "~58.0.12",
    "expo-haptics": "~58.0.8",
    "expo-image": "~58.0.18",
    "expo-keep-awake": "~58.0.4",
    "expo-linear-gradient": "~58.0.4",
    "expo-location": "~58.0.22",
    "expo-screen-orientation": "~58.0.4",
    "expo-sensors": "~58.0.5",
    "expo-splash-screen": "~58.0.14",
    "expo-status-bar": "~58.0.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-svg": "15.16.0",
    "react-native-web": "^0.21.4",
    "react-native-worklets": "0.13.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.2",
    "@types/react": "~19.3.0",
    "babel-preset-expo": "~58.0.0",
    "serve": "^14.2.6",
    "three": "^0.170.0",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit -p . && tsc --noEmit -p e2e && tsc --noEmit -p scripts",
    "export:web": "expo export --platform web --output-dir dist",
    "e2e": "npm run export:web && playwright test -c e2e/playwright.config.ts",
    "e2e:only": "playwright test -c e2e/playwright.config.ts",
    "test:logic": "LOGIC_ONLY=1 playwright test -c e2e/playwright.config.ts logic",
    "brand": "node scripts/make-brand-assets.mts",
    "sounds": "node scripts/make-sounds.mts",
    "sounds:import": "node scripts/import-sounds.mts",
    "zombie-sprites": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/make-zombie-sprites.mts"
  },
  "private": true,
  "engines": {
    "node": "^22.13.0 || ^24.3.0 || >=26.0.0"
  }
}
